{
  "name": "equity-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Equity research RAG platform: ingests SEC filings, answers questions with citations, extracts structured financials, and measures its own accuracy with an eval pipeline.",
  "scripts": {
    "ingest": "tsx scripts/ingest.ts",
    "build-fixture": "tsx scripts/build-fixture.ts",
    "ask": "tsx scripts/ask.ts",
    "extract": "tsx scripts/extract.ts",
    "eval": "tsx scripts/eval.ts",
    "web": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "htmlparser2": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
